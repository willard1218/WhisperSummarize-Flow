    1: from __future__ import annotations
       
    1: import json
    1: import tempfile
    1: import unittest
    1: from pathlib import Path
    1: from types import SimpleNamespace
    1: from unittest.mock import patch
       
    1: from pipeline.transcribers import WhisperCPPTranscriber, WhisperKitReportWriter, WhisperKitTranscriber
       
       
    2: class TranscriberTests(unittest.TestCase):
    1:     def test_whisper_cpp_transcriber_returns_existing_output(self) -> None:
    2:         with tempfile.TemporaryDirectory() as temp_dir:
    1:             audio_path = Path(temp_dir) / "sample.mp3"
    1:             transcript_path = Path(temp_dir) / "sample.srt.txt"
    1:             audio_path.write_text("", encoding="utf-8")
    1:             transcript_path.write_text("ok", encoding="utf-8")
       
    1:             transcriber = WhisperCPPTranscriber("/tmp/gensrt.sh")
    2:             with patch("pipeline.transcribers.subprocess.run", return_value=SimpleNamespace(returncode=0)):
    1:                 result = transcriber.transcribe(audio_path, Path(temp_dir))
       
    1:             self.assertEqual(result, transcript_path)
       
    1:     def test_whisperkit_report_writer_renders_srt_and_plain_text(self) -> None:
    2:         with tempfile.TemporaryDirectory() as temp_dir:
    1:             audio_path = Path(temp_dir) / "clip.mp3"
    1:             audio_path.write_text("", encoding="utf-8")
       
    1:             writer = WhisperKitReportWriter(audio_path)
    2:             srt_path = writer.write(
    1:                 [
    1:                     {"start": 0.0, "end": 1.25, "text": "hello"},
    1:                     {"start": 1.5, "end": 2.0, "text": "world", "speaker": "A"},
                       ]
                   )
       
    1:             self.assertEqual(srt_path.read_text(encoding="utf-8").splitlines()[1], "00:00:00,000 --> 00:00:01,250")
    1:             self.assertIn("[A] world", audio_path.with_suffix(".txt").read_text(encoding="utf-8"))
       
    1:     def test_whisperkit_transcriber_processes_json_report(self) -> None:
    2:         with tempfile.TemporaryDirectory() as temp_dir:
    1:             output_dir = Path(temp_dir)
    1:             audio_path = output_dir / "clip.mp3"
    1:             wav_path = output_dir / "clip.wav"
    1:             report_dir = output_dir / "reports" / "clip"
    1:             report_dir.mkdir(parents=True)
    1:             audio_path.write_text("", encoding="utf-8")
    1:             wav_path.write_text("", encoding="utf-8")
    2:             (report_dir / "transcription.json").write_text(
    1:                 json.dumps({"segments": [{"start": 0, "end": 1, "text": "hello"}]}),
    1:                 encoding="utf-8",
                   )
       
    1:             transcriber = WhisperKitTranscriber("/tmp/whisperkit")
    2:             with patch("pipeline.transcribers.subprocess.run", return_value=SimpleNamespace(returncode=0)):
    1:                 result = transcriber.transcribe(audio_path, output_dir)
       
    1:             self.assertEqual(result, output_dir / "clip.srt.txt")
    1:             self.assertTrue((output_dir / "clip.txt").exists())
       
       
    1: if __name__ == "__main__":
           unittest.main()
