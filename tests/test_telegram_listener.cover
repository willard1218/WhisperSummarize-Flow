    2: class FakeDownloader:
    1:     def __init__(self, should_succeed: bool = True):
    9:         self.should_succeed = should_succeed
    9:         self.calls: list[tuple[str, Path]] = []
       
    1:     def download(self, file_id: str, destination: Path) -> bool:
    3:         self.calls.append((file_id, destination))
    3:         destination.parent.mkdir(parents=True, exist_ok=True)
    3:         if self.should_succeed:
    3:             destination.write_text("audio", encoding="utf-8")
    3:         return self.should_succeed
       
       
