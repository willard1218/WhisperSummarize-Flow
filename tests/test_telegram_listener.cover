    1:     def test_transcription_status_provider_real_locks(self) -> None:
    1:         import fcntl
    1:         import os
    2:         with tempfile.TemporaryDirectory() as temp_dir:
    1:             lock_file = Path(temp_dir) / "test.lock"
    1:             dir_lock = Path(temp_dir) / "dir.lock"
                   
    1:             provider = TranscriptionStatusProvider(lock_paths=[lock_file, dir_lock])
                   
                   # 1. Idle
    1:             self.assertEqual(provider.describe(), "空閒中")
                   
                   # 2. Flock busy
    2:             with open(lock_file, "w") as f:
    1:                 fcntl.flock(f, fcntl.LOCK_EX)
    1:                 self.assertEqual(provider.describe(), "忙碌中")
                   
                   # 3. Flock stale (file exists but no lock)
    1:             lock_file.touch()
    1:             self.assertEqual(provider.describe(), "空閒中")
                   
                   # 4. Dir lock busy (process alive)
    1:             dir_lock.mkdir()
    1:             (dir_lock / "pid").write_text(str(os.getpid()))
    1:             self.assertEqual(provider.describe(), "忙碌中")
                   
                   # 5. Dir lock stale (process dead)
    1:             (dir_lock / "pid").write_text("999999") # Hopefully dead
    1:             self.assertEqual(provider.describe(), "空閒中")
       
    1:     def test_poller_advances_offset_even_when_handler_raises(self) -> None:
    1:         api_client = FakeApiClient()
    1:         api_client.updates = {"ok": True, "result": [{"update_id": 3, "message": {}}, {"update_id": 4, "message": {}}]}
       
    2:         class FlakyHandler:
    1:             def __init__(self):
    1:                 self.calls = 0
       
    1:             def handle(self, update):  # noqa: ANN001
    2:                 self.calls += 1
    2:                 if self.calls == 1:
    1:                     raise RuntimeError("boom")
       
    1:         poller = TelegramPoller(api_client, FlakyHandler(), sleep_seconds=0)
    1:         poller.poll_once()
       
    1:         self.assertEqual(poller.last_update_id, 4)
       
       
