    1:     def test_transcription_lock_behaves_correctly(self) -> None:
    1:         import fcntl
    1:         import threading
    1:         import time
    2:         with tempfile.TemporaryDirectory() as temp_dir:
    1:             lock_path = Path(temp_dir) / "test.lock"
    1:             lock = TranscriptionLock(lock_file=str(lock_path))
                   
                   # 1. Test basic re-entrance or concurrent thread acquisition
    1:             def acquire_and_hold(hold_seconds: float):
    4:                 with lock:
    2:                     time.sleep(hold_seconds)
                   
    1:             t_start = time.time()
    1:             t1 = threading.Thread(target=acquire_and_hold, args=(0.2,))
    1:             t2 = threading.Thread(target=acquire_and_hold, args=(0.1,))
                   
    1:             t1.start()
    1:             time.sleep(0.05) # Ensure t1 gets it
    1:             t2.start()
                   
    1:             t1.join()
    1:             t2.join()
    1:             duration = time.time() - t_start
                   
                   # Should take at least 0.3s if sequential
    1:             self.assertGreaterEqual(duration, 0.3)
       
                   # 2. Test cross-process (using flock directly to simulate another process)
    2:             with open(lock_path, "w") as f:
    1:                 fcntl.flock(f, fcntl.LOCK_EX)
                       
                       # Try to acquire in another thread (should block)
    1:                 success = []
    1:                 def try_acquire():
    2:                     with lock:
    1:                         success.append(True)
                       
    1:                 t3 = threading.Thread(target=try_acquire)
    1:                 t3.start()
    1:                 t3.join(timeout=0.1)
                       
    1:                 self.assertTrue(t3.is_alive()) # Still blocked
                       
    1:                 fcntl.flock(f, fcntl.LOCK_UN)
    1:                 t3.join(timeout=0.5)
    1:                 self.assertTrue(len(success) > 0)
       
       
