    1:     def _is_flock_busy(self, path: Path) -> bool:
    5:         if not path.exists():
    1:             return False
    4:         try:
    8:             with open(path, "r") as f:
                       # Try to acquire an exclusive lock, non-blocking
                       # If this succeeds, it means no one else has the lock
    4:                 fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                       # We got the lock! So it's NOT busy.
    3:                 fcntl.flock(f, fcntl.LOCK_UN)
    3:                 return False
    1:         except (IOError, BlockingIOError):
                   # Lock is held by someone else
    1:             return True
               except Exception:
                   # Fallback to simple existence check if anything weird happens
                   return path.exists()
       
    1:     def _is_dir_lock_busy(self, path: Path) -> bool:
    4:         if not path.exists():
    2:             return False
    2:         pid_file = path / "pid"
    2:         if not pid_file.exists():
                   # Directory exists but no pid file? Might be transitioning or stale.
                   return True
    2:         try:
    2:             pid = int(pid_file.read_text().strip())
                   # Check if process is alive
    2:             os.kill(pid, 0)
    1:             return True
    1:         except (ProcessLookupError, ValueError, PermissionError):
                   # Process is dead or invalid pid
    1:             return False
       
    1:     def is_busy(self) -> bool:
               # Check whisper_transcription.lock (python flock)
    5:         if self._is_flock_busy(self.lock_paths[0]):
    1:             return True
               
               # Check gensrt.lock (shell directory lock)
    4:         if self._is_dir_lock_busy(self.lock_paths[1]):
    1:             return True
                   
    3:         return False
       
    1:     def describe(self) -> str:
    5:         return "忙碌中" if self.is_busy() else "空閒中"
       
       
    2: class PipelineLauncher:
    1:     def __init__(self, base_dir: Path, python_executable: str):
               self.base_dir = base_dir
               self.python_executable = python_executable
               self.script_path = self.base_dir / "pipeline" / "run_daily_pipeline.py"
       
    1:     def build_command(self, chat_id: str | int, url: str | None = None, local_file: Path | None = None) -> list[str]:
               command = [
                   self.python_executable,
                   str(self.script_path),
                   "--recipient-group", "all",
                   "--enable-transcribe", "1",
                   "--enable-summarize", "1",
                   "--enable-mail", "1",
                   "--enable-telegram", "1",
                   "--telegram-progress",
                   "--telegram-chat-id", str(chat_id),
                   "--task-origin", "telegram",
               ]
               if url:
                   command += ["--url", url]
               elif local_file:
                   command += ["--local-file", str(local_file)]
               return command
       
    1:     def run(self, chat_id: str | int, url: str | None = None, local_file: Path | None = None) -> None:
               command = self.build_command(chat_id=chat_id, url=url, local_file=local_file)
               subprocess.Popen(command, cwd=str(self.base_dir))
       
       
    2: class TelegramFileDownloader:
    1:     def __init__(self, api_client: TelegramApiClient, bot_token: str):
               self.api_client = api_client
               self.bot_token = bot_token
       
    1:     def download(self, file_id: str, destination: Path) -> bool:
               response = self.api_client.get_file(file_id)
               if not response or not response.get("ok"):
                   return False
       
               file_path = response["result"]["file_path"]
               url = f"https://api.telegram.org/file/bot{self.bot_token}/{file_path}"
               logger.info(f"[DOWNLOADING] {url} to {destination}")
               urllib.request.urlretrieve(url, destination)
               return True
       
       
