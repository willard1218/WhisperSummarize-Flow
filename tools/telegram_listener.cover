    5:         if "video" in message:
    1:             video = message["video"]
    1:             original_name = video.get("file_name", f"video_{timestamp}.mp4")
    2:             return MediaMessage(
    1:                 file_id=video["file_id"],
    1:                 kind="video",
    1:                 original_name=original_name,
    1:                 extension=original_name.rsplit(".", 1)[-1] if "." in original_name else "mp4",
    1:                 duration=video.get("duration", 0),
                   )
       
    4:         if "video_note" in message:
    1:             video_note = message["video_note"]
    2:             return MediaMessage(
    1:                 file_id=video_note["file_id"],
    1:                 kind="video_note",
    1:                 original_name=f"video_note_{timestamp}.mp4",
    1:                 extension="mp4",
    1:                 duration=video_note.get("duration", 0),
                   )
       
    3:         if "document" in message:
                   document = message["document"]
                   mime = document.get("mime_type", "")
                   original_name = document.get("file_name", "")
                   if mime.startswith(("audio/", "video/")) or original_name.lower().endswith(MEDIA_EXTENSIONS):
                       if not original_name:
                           original_name = f"document_{timestamp}.m4a"
                       return MediaMessage(
                           file_id=document["file_id"],
                           kind="document",
                           original_name=original_name,
                           extension=original_name.rsplit(".", 1)[-1],
                           duration=document.get("duration", 0),
                       )
       
    3:         return None
       
    2:     @staticmethod
    2:     def safe_filename(original_name: str, fallback_kind: str, extension: str) -> str:
    3:         cleaned = re.sub(r"[^a-zA-Z0-9._-]", "_", original_name)
    3:         if not cleaned or cleaned.startswith("___"):
                   return f"{fallback_kind}_{int(time.time())}.{extension}"
    3:         return cleaned
       
       
