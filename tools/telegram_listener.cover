    2: class TelegramApiClient:
    1:     def __init__(self, settings: ListenerSettings):
               self.settings = settings
       
    1:     def call_api(self, method: str, data: dict | None = None) -> dict | None:
               url = self.settings.api_url + method
               payload = json.dumps(data).encode("utf-8") if data else None
               
               if method != "getUpdates":
                   logger.info(f"[API CALL] Method: {method}, Data: {data}")
       
               for attempt in range(3):
                   request = urllib.request.Request(
                       url,
                       data=payload,
                       headers={"Content-Type": "application/json"},
                   )
                   try:
                       with urllib.request.urlopen(request, timeout=60) as response:
                           res_data = json.loads(response.read().decode())
                           if not res_data.get("ok"):
                               logger.error(f"[API ERROR] {method}: {res_data.get('description')}")
                           return res_data
                   except Exception as exc:
                       logger.warning(f"[API ATTEMPT {attempt+1} FAILED] {method}: {exc}")
                       if attempt < 2:
                           time.sleep(2)
                       else:
                           return None
               return None
       
    1:     def send_message(self, chat_id: str | int, text: str, reply_markup: dict | None = None) -> dict | None:
               payload = {
                   "chat_id": chat_id,
                   "text": text,
                   "disable_web_page_preview": True,
               }
               if reply_markup:
                   payload["reply_markup"] = reply_markup
               return self.call_api("sendMessage", payload)
       
    1:     def edit_message_reply_markup(self, chat_id: str | int, message_id: int, reply_markup: dict | None = None) -> dict | None:
               payload = {"chat_id": chat_id, "message_id": message_id}
               if reply_markup is not None:
                   payload["reply_markup"] = reply_markup
               return self.call_api("editMessageReplyMarkup", payload)
       
    1:     def answer_callback_query(self, callback_query_id: str, text: str | None = None) -> dict | None:
               payload = {"callback_query_id": callback_query_id}
               if text:
                   payload["text"] = text
               return self.call_api("answerCallbackQuery", payload)
       
    1:     def get_updates(self, offset: int, timeout: int = 30) -> dict | None:
               return self.call_api("getUpdates", {"offset": offset, "timeout": timeout})
       
    1:     def get_file(self, file_id: str) -> dict | None:
               return self.call_api("getFile", {"file_id": file_id})
       
    1:     def delete_webhook(self, drop_pending_updates: bool = False) -> dict | None:
               return self.call_api("deleteWebhook", {"drop_pending_updates": drop_pending_updates})
       
       
    2: class UrlTaskStore:
    1:     """Stores full URLs and provides a short ID for Telegram callback_data limits."""
    1:     def __init__(self, store_path: Path):
    9:         self.path = store_path
    9:         self.path.parent.mkdir(parents=True, exist_ok=True)
       
    1:     def _load(self) -> dict:
    6:         if not self.path.exists():
    4:             return {}
    2:         try:
    2:             return json.loads(self.path.read_text(encoding="utf-8"))
               except Exception:
                   return {}
       
    1:     def _save(self, data: dict):
    5:         self.path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
       
    1:     def get_id_for_url(self, url: str) -> str:
    5:         url_hash = hashlib.md5(url.encode("utf-8")).hexdigest()[:16]
    5:         data = self._load()
    5:         data[url_hash] = url
    5:         self._save(data)
    5:         return url_hash
       
    1:     def get_url_by_id(self, url_id: str) -> str | None:
    1:         return self._load().get(url_id)
       
       
    2: class TranscriptionStatusProvider:
    1:     def __init__(self, lock_paths: list[Path] | None = None):
    1:         self.lock_paths = lock_paths or [
