    2:             return MediaMessage(
    1:                 file_id=audio["file_id"],
    1:                 kind="audio",
    1:                 original_name=original_name,
    1:                 extension=original_name.rsplit(".", 1)[-1],
    1:                 duration=audio.get("duration", 0),
